# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
#
# If you build through the ESPHome Device Builder add-on instead, it keeps its
# own secrets.yaml alongside the config and this file is only a checklist.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
wifi_gateway: "192.168.1.1"

# Reserve this in the router, or pick one outside the DHCP pool. A static
# address saves a DHCP exchange on every wake, with the radio on.
panel_static_ip: "192.168.1.60"

# esphome wizard prints one, or: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_A_BASE64_32_BYTE_KEY"

ota_password: "choose-something"
fallback_password: "choose-something-else"
